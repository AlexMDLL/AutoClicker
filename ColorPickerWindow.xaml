<Window x:Class="AutoClicker.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color picker"
        Width="700" Height="496"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="Copy"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid Width="12" Height="12">
                                <Border Width="8" Height="8" CornerRadius="2" BorderThickness="1"
                                        BorderBrush="{DynamicResource MutedBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Width="8" Height="8" CornerRadius="2" BorderThickness="1"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource MutedBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFaintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="18" Background="{DynamicResource WindowBgGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="◐" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="Выбор цвета" FontSize="14" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource CloseWindowButton}" Content="✕" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,10,0" Click="Cancel_Click"/>
            </Grid>

            <!-- КОНТЕНТ -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Поле насыщенности/яркости + оттенок -->
                <StackPanel Grid.Column="0">
                    <Border x:Name="SvSurface" Height="232" CornerRadius="12" ClipToBounds="True"
                            Background="{DynamicResource ControlBgBrush}"
                            MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Sv_MouseUp"
                            MouseLeave="Sv_MouseLeave" Cursor="Cross">
                        <Grid>
                            <Rectangle x:Name="HueBase"/>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#FF000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="SvMarker" Width="18" Height="18" Stroke="White" StrokeThickness="2"
                                         Fill="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Grid x:Name="HueContainer" Height="22" Margin="0,14,0,0">
                        <Border x:Name="HueBar" Height="14" VerticalAlignment="Center" CornerRadius="7" ClipToBounds="True"
                                Cursor="Hand" MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove"
                                MouseLeftButtonUp="Hue_MouseUp" MouseLeave="Hue_MouseLeave">
                            <Rectangle x:Name="HueGradient">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0"/>
                                        <GradientStop Color="#FFFFFF00" Offset="0.1667"/>
                                        <GradientStop Color="#FF00FF00" Offset="0.3333"/>
                                        <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#FF0000FF" Offset="0.6667"/>
                                        <GradientStop Color="#FFFF00FF" Offset="0.8333"/>
                                        <GradientStop Color="#FFFF0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="HueMarker" Width="18" Height="18" Stroke="White" StrokeThickness="2"
                                     Fill="Transparent">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <TextBlock x:Name="HintText" Text="Перетащите маркер по полю, чтобы выбрать цвет"
                               Style="{StaticResource MutedText}" Margin="2,14,0,0"/>
                </StackPanel>

                <!-- Поля значений -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HEX" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HexBox" Grid.Column="1" Height="34" FontFamily="{StaticResource MonoFont}"
                                 FontSize="13" Padding="10,0" VerticalContentAlignment="Center"
                                 KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
                        <Button Grid.Column="2" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Click="CopyHex_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RGB" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="RBox" Width="58" Height="34" FontFamily="{StaticResource MonoFont}"
                                     FontSize="13" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center"
                                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
                            <TextBox x:Name="GBox" Width="58" Height="34" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}"
                                     FontSize="13" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center"
                                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
                            <TextBox x:Name="BBox" Width="58" Height="34" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}"
                                     FontSize="13" Padding="6,0" TextAlignment="Center" VerticalContentAlignment="Center"
                                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Click="CopyRgb_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HSL" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="HslBox" Grid.Column="1" Height="34" IsReadOnly="True"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="10,0"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <Button Grid.Column="2" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Click="CopyHsl_Click"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CMYK" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CmykBox" Grid.Column="1" Height="34" IsReadOnly="True"
                                 FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="10,0"
                                 VerticalContentAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <Button Grid.Column="2" Style="{StaticResource CopyButton}" Margin="8,0,0,0" Click="CopyCmyk_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- НИЗ: превью и кнопки -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OldLabel" Text="Было" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <Border x:Name="PreviewOld" Width="34" Height="24" CornerRadius="7" Margin="8,0,18,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="NewLabel" Text="Станет" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <Border x:Name="PreviewNew" Width="34" Height="24" CornerRadius="7" Margin="8,0,0,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource GhostButton}"
                                Width="110" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
                        <Button x:Name="ApplyButton" Content="Применить" Style="{StaticResource PrimaryButton}"
                                Width="132" Height="38" Click="Apply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
