    <!-- ===================== ВКЛАДКИ / НАВИГАЦИЯ ===================== -->
    <Style x:Key="NavItemClassic" TargetType="TabItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Margin="0,2" Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent"/>
                        <Rectangle x:Name="Indicator" Width="3" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="IndicatorShift" X="-6"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Header}" Margin="11,0,0,0" FontSize="12.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                            <Setter TargetName="Indicator" Property="Height" Value="20"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndicatorShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IndicatorShift" Storyboard.TargetProperty="X"
                                                         To="-6" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItemCompact" TargetType="TabItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,3" Height="46" Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent"/>
                        <Rectangle x:Name="Indicator" Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                        <Path x:Name="Icon" Data="{TemplateBinding Tag}" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItemMinimal" TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" CornerRadius="9" Padding="12,6" Margin="0,0,8,4" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="Icon" Data="{TemplateBinding Tag}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Header}" Margin="8,0,0,0" FontSize="12.5"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource ForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Классика: боковая панель 214 px -->
    <ControlTemplate x:Key="TabsClassic" TargetType="TabControl">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,0,0,14">
                <Grid Margin="12,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding [NavTitle]}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,10" Opacity="0.9"/>

                    <TabPanel Grid.Row="1" x:Name="HeaderPanel" IsItemsHost="True"/>

                    <!-- Сессия: растягивается, статистика сверху, действия снизу -->
                    <Border Grid.Row="2" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding [SectionSession]}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Opacity="0.85"/>

                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ClicksDone}" FontSize="30" FontWeight="Bold"
                                           FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource ForegroundBrush}"/>
                                <TextBlock Text="{Binding [LabelClicks]}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Cps, StringFormat={}{0:0.0}}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding [LabelCps]}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="4,2,12,0"/>
                                    <TextBlock Text="{Binding ElapsedText}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Row="2" Margin="0,8,0,0" ClipToBounds="True" VerticalAlignment="Center">
                                <Polyline Points="{Binding CpsPoints}" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Opacity="0.9"/>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding [BtnStart]}" Command="{Binding StartCommand}"
                                        Style="{StaticResource PrimaryButton}" Height="30" FontSize="11" Padding="0"/>
                                <Button Grid.Column="2" Content="{Binding [BtnStop]}" Command="{Binding StopCommand}"
                                        Style="{StaticResource DangerButton}" Height="30" FontSize="11" Padding="0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Текущая цель -->
                    <Border Grid.Row="3" Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding [SectionTarget]}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Opacity="0.85"/>
                            <TextBlock Text="{Binding TargetSummaryText}" FontSize="11" Foreground="{DynamicResource ForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding TargetSummaryText}"/>
                            <TextBlock Text="{Binding ModeText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Хоткей и версия -->
                    <StackPanel Grid.Row="4" Margin="10,0,10,0">
                        <Border Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [SectionHotkey]}" FontSize="9.5" Foreground="{DynamicResource MutedBrush}" Opacity="0.85"/>
                                <TextBlock Text="{Binding HotkeyDisplay}" FontSize="13" FontWeight="SemiBold"
                                           FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,6"/>
                        <TextBlock Text="AutoClicker Pro" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Opacity="0.65"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="22,18,22,8">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="ContentShift" X="0" Y="0"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Компакт: иконки 64 px -->
    <ControlTemplate x:Key="TabsCompact" TargetType="TabControl">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,1" CornerRadius="0,0,0,14">
                <DockPanel Margin="8,14,8,12">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Border Background="{DynamicResource ControlBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4,6" Margin="0,0,0,8"
                                ToolTip="{Binding HotkeyDisplay}">
                            <TextBlock Text="{Binding HotkeyDisplay}" FontSize="9.5" TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding AppVersion}" FontSize="9" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Padding="22,16,22,8">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="ContentShift" X="0" Y="0"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Border>
        </Grid>
    </ControlTemplate>

    <!-- Минимал: верхнее меню, без сайдбара -->
    <ControlTemplate x:Key="TabsMinimal" TargetType="TabControl">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10,12,0">
                <Grid>
                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,6" Opacity="0.6"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="18,14,18,8">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="ContentShift" X="0" Y="0"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItemClassic}"/>
        <Setter Property="Template" Value="{StaticResource TabsClassic}"/>
    </Style>

    <!-- ===================== КАРТОЧКИ И ТЕКСТ ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="InnerCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

</ResourceDictionary>
