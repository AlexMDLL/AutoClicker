<Window x:Class="AutoClicker.KeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key capture"
        Width="480" Height="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="12" CornerRadius="16" Background="{DynamicResource WindowBgGradientBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Нажмите клавишу"
                               FontSize="13.5" FontWeight="SemiBold" Margin="18,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="✕" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="18,16,18,8" CornerRadius="10" Background="{DynamicResource InputBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock x:Name="PreviewText" Text="…"
                           FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="2" x:Name="HintText" Text="Отпустите — сочетание сохранится. Esc — отмена."
                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       Margin="18,0,18,16" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
